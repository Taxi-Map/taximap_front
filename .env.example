# Copiar para .env e preencher. O .env não deve ser versionado.
#
# REGRA: tudo o que começa por VITE_ é embutido no bundle JavaScript e fica
# legível para qualquer visitante do site. Nunca colocar chaves de API aqui.
# Segredos vivem apenas nas Environment Variables da Vercel (sem prefixo VITE_).


# ============================================================
#  Cliente (browser) — público, vai no bundle
# ============================================================

# Para onde os formulários enviam candidaturas e mensagens.
# Em produção e em preview, a função /api/lead corre no mesmo domínio,
# por isso o caminho relativo é o valor correto — sem CORS, sem domínio fixo.
VITE_LEADS_ENDPOINT=/api/lead

# Contentful (CMS dos slides do hero)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

# API do produto (opcional, usado por src/lib/api-client.ts)
VITE_API_URL=


# ============================================================
#  Servidor (Vercel Functions) — SEGREDO, nunca no bundle
#  Definir em: Vercel > Project > Settings > Environment Variables
# ============================================================

# Chave da API do Resend (começa por re_). Obrigatória para os formulários
# funcionarem; sem ela a função responde 503 e o site mostra os contactos diretos.
RESEND_API_KEY=

# Para onde chegam os avisos de novas candidaturas e mensagens.
LEADS_TO_EMAIL=geral.taximap@gmail.com

# Remetente. Tem de usar um domínio verificado no Resend — enquanto o
# taximap.ao não estiver verificado, "onboarding@resend.dev" funciona mas só
# entrega no email do dono da conta Resend.
LEADS_FROM_EMAIL=Táxi Map <noreply@taximap.ao>
